{
  "name": "fusionlabs-offers-optimizer",
  "version": "1.0.0",
  "private": true,
  "description": "Refactored offers resolver with a denormalized OfferIndex for fast eligibility lookups.",
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d && echo 'Postgres up.'",
    "db:down": "docker compose down",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "seed": "ts-node prisma/seed.ts",
    "dev": "ts-node src/server.ts",
    "start": "node dist/src/server.js",
    "refresh:offer-index": "ts-node src/jobs/refreshOfferIndex.ts"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0",
    "graphql": "^16.9.0",
    "graphql-parse-resolve-info": "^4.13.0",
    "graphql-yoga": "^5.10.4"
  },
  "devDependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.10",
    "dotenv": "^17.4.2",
    "pg": "^8.20.0",
    "prisma": "^7.8.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
