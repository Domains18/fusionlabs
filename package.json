{
  "name": "fusionlabs-offers-optimizer",
  "version": "1.0.0",
  "private": true,
  "description": "Refactored offers resolver with a denormalized OfferIndex for fast eligibility lookups.",
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "refresh:offer-index": "ts-node src/jobs/refreshOfferIndex.ts"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0",
    "graphql": "^16.9.0",
    "graphql-parse-resolve-info": "^4.13.0"
  },
  "devDependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.10",
    "dotenv": "^17.4.2",
    "pg": "^8.20.0",
    "prisma": "^7.8.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
